go 1.25.11

// Astra monorepo workspace.
// Each sub-module can evolve and be versioned independently; the workspace file
// wires them together for local development so that cross-module imports resolve
// to the local tree rather than a published tag.
//
// Usage:
//   go work use ./foo   — add a new module to the workspace
//   GOWORK=off go build — disable workspace (use published versions)
//
// Intra-workspace require directives use the conventional Go zero-version
//   v0.0.0-00010101000000-000000000000
// paired with local-path replace directives so that `go mod tidy` never
// tries to resolve these modules from VCS (they have no published tag yet).
//
// Module groups:
//   Core:         . (main astra), auth, boot, config, mq, orm, grpc, session
//   Storage:      cache, mongodb, storage
//   Infra:        alert, audit, discovery, dtx/orm, dtx/redis, lock, runner
//   Network:      quic, stream, taskqueue
//   Observability: otel, benchmark, testutil, validate
//   Utilities:    client, loadbalance, mask, notify, rule, search, token
//   Middleware:   middleware/security
//   Examples:     examples/*
//   E2E tests:    e2e, e2e/orm

use (
	. // github.com/astra-go/astra — core framework

	./alert // alerting & notifications
	./audit // audit logging
	./auth // token issuance, account management

	./benchmarks // performance benchmarks
	./boot // service bootstrap & health

	./cache // Redis / in-process cache

	./client // generic HTTP/REST client
	./config // configuration loading (Nacos, Etcd, Apollo)
	./config/vault // Vault secrets backend
	./discovery // service discovery
	./dtx/orm // distributed transaction (ORM adapter)
	./dtx/redis // distributed transaction (Redis adapter)

	./e2e // end-to-end tests
	./e2e/orm // ORM integration tests

	./examples/basic // minimal example
	./examples/cache // cache example
	./examples/crud // CRUD API example
	./examples/hello
	./examples/jwt // JWT authentication example
	./examples/mq
	./examples/orm // ORM example
	./examples/quic // QUIC/HTTP3 example
	./examples/quickstart // quickstart
	./examples/reference-blog // reference blog (full-featured)
	./examples/showcase // showcase
	./examples/techempower // TechEmpower benchmarks
	./examples/wasm
	./examples/websocket // WebSocket example
	./grpc // gRPC server/client
	./loadbalance // load balancing strategies
	./lock // distributed locking
	./mask // data masking (PII redactor)

	./middleware/security // security middleware (JWT, rate-limit, tenant, ...)
	./mongodb // MongoDB driver
	./mq // multi-backend message queue (Kafka, NATS, RocketMQ, ...)
	./notify // push notifications
	./orm // GORM + sharding + RW splitting
	./orm/clickhouse // ClickHouse adapter
	./otel // OpenTelemetry instrumentation

	./quic // QUIC/HTTP3 server
	./rule // business rule engine
	./runner // long-running process manager
	./search // full-text search
	./session // session management
	./storage // cloud storage (S3 / OSS / COS)
	./stream // streaming (gRPC, WebSocket)
	./taskqueue // task queue (Asynq-compatible)
	./testutil // testing utilities
	./token // token utilities
	./validate // struct validation
)

// Intra-workspace replace directives.
// ALL internal module cross-references use the zero pseudo-version so that
// `go mod tidy` skips VCS resolution and reads the local go.mod directly.
replace (
	github.com/astra-go/astra v0.0.0-00010101000000-000000000000 => ./
	github.com/astra-go/astra/alert v0.0.0-00010101000000-000000000000 => ./alert
	github.com/astra-go/astra/auth v0.0.0-00010101000000-000000000000 => ./auth
	github.com/astra-go/astra/benchmarks v0.0.0-00010101000000-000000000000 => ./benchmarks
	github.com/astra-go/astra/boot v0.0.0-00010101000000-000000000000 => ./boot
	github.com/astra-go/astra/cache v0.0.0-00010101000000-000000000000 => ./cache
	github.com/astra-go/astra/client v0.0.0-00010101000000-000000000000 => ./client
	github.com/astra-go/astra/config v0.0.0-00010101000000-000000000000 => ./config
	github.com/astra-go/astra/config/vault v0.0.0-00010101000000-000000000000 => ./config/vault
	github.com/astra-go/astra/discovery v0.0.0-00010101000000-000000000000 => ./discovery
	github.com/astra-go/astra/dtx/orm v0.0.0-00010101000000-000000000000 => ./dtx/orm
	github.com/astra-go/astra/dtx/redis v0.0.0-00010101000000-000000000000 => ./dtx/redis
	github.com/astra-go/astra/e2e/orm v0.0.0-00010101000000-000000000000 => ./e2e/orm
	github.com/astra-go/astra/examples/basic v0.0.0-00010101000000-000000000000 => ./examples/basic
	github.com/astra-go/astra/examples/cache v0.0.0-00010101000000-000000000000 => ./examples/cache
	github.com/astra-go/astra/examples/crud v0.0.0-00010101000000-000000000000 => ./examples/crud
	github.com/astra-go/astra/examples/jwt v0.0.0-00010101000000-000000000000 => ./examples/jwt
	github.com/astra-go/astra/examples/quickstart v0.0.0-00010101000000-000000000000 => ./examples/quickstart
	github.com/astra-go/astra/examples/reference-blog v0.0.0-00010101000000-000000000000 => ./examples/reference-blog
	github.com/astra-go/astra/examples/showcase v0.0.0-00010101000000-000000000000 => ./examples/showcase
	github.com/astra-go/astra/examples/techempower v0.0.0-00010101000000-000000000000 => ./examples/techempower
	github.com/astra-go/astra/examples/websocket v0.0.0-00010101000000-000000000000 => ./examples/websocket
	github.com/astra-go/astra/grpc v0.0.0-00010101000000-000000000000 => ./grpc
	github.com/astra-go/astra/loadbalance v0.0.0-00010101000000-000000000000 => ./loadbalance
	github.com/astra-go/astra/lock v0.0.0-00010101000000-000000000000 => ./lock
	github.com/astra-go/astra/middleware/security v0.0.0-00010101000000-000000000000 => ./middleware/security
	github.com/astra-go/astra/mongodb v0.0.0-00010101000000-000000000000 => ./mongodb
	github.com/astra-go/astra/mq v0.0.0-00010101000000-000000000000 => ./mq
	github.com/astra-go/astra/notify v0.0.0-00010101000000-000000000000 => ./notify
	github.com/astra-go/astra/orm v0.0.0-00010101000000-000000000000 => ./orm
	github.com/astra-go/astra/orm/clickhouse v0.0.0-00010101000000-000000000000 => ./orm/clickhouse
	github.com/astra-go/astra/otel v0.0.0-00010101000000-000000000000 => ./otel
	github.com/astra-go/astra/quic v0.0.0-00010101000000-000000000000 => ./quic
	github.com/astra-go/astra/rule v0.0.0-00010101000000-000000000000 => ./rule
	github.com/astra-go/astra/runner v0.0.0-00010101000000-000000000000 => ./runner
	github.com/astra-go/astra/search v0.0.0-00010101000000-000000000000 => ./search
	github.com/astra-go/astra/session v0.0.0-00010101000000-000000000000 => ./session
	github.com/astra-go/astra/storage v0.0.0-00010101000000-000000000000 => ./storage
	github.com/astra-go/astra/stream v0.0.0-00010101000000-000000000000 => ./stream
	github.com/astra-go/astra/taskqueue v0.0.0-00010101000000-000000000000 => ./taskqueue
	github.com/astra-go/astra/testutil v0.0.0-00010101000000-000000000000 => ./testutil
	github.com/astra-go/astra/token v0.0.0-00010101000000-000000000000 => ./token
	// consul/proto-public v0.8.0 requires go 1.25.8; pin to v0.6.5 which requires go 1.25.0.
	// config/go.mod carries the same replace for module-level builds.
	github.com/hashicorp/consul/proto-public v0.8.0 => github.com/hashicorp/consul/proto-public v0.6.5
	github.com/astra-go/astra/examples/hello v0.0.0-00010101000000-000000000000 => ./examples/hello
	github.com/astra-go/astra/examples/mq v0.0.0-00010101000000-000000000000 => ./examples/mq
	github.com/astra-go/astra/examples/wasm v0.0.0-00010101000000-000000000000 => ./examples/wasm
)

